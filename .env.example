# ─────────────── General Settings ───────────────
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ─────────────── Active Database ───────────────
ACTIVE_DATABASE=local

# ─────────────── Local Database ───────────────
DB_NAME=garment_management
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# ─────────────── Render Database ───────────────
DATABASE_URL=postgresql://user:password@host:port/database

# ─────────────── CORS ───────────────
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,https://*.onrender.com